# Copie para .env e ajuste se necessário: cp .env.example .env
NODE_ENV=development
PORT=3000

# Mesmo usuário/senha/banco do docker-compose.yml (apenas para desenvolvimento)
DATABASE_URL=postgresql://app:app@localhost:5432/agendamento
DATABASE_SSL=false

CORS_ORIGIN=http://localhost:5173
CLINIC_TIMEZONE=America/Sao_Paulo

# Opcional: Redis do docker-compose. Comente a linha para usar cache em memória.
REDIS_URL=redis://localhost:6379

# Rate limiting (por IP, contador em memória). Os valores abaixo são os padrões.
# Quantos proxies confiáveis existem entre o cliente e a API (define de onde sai
# o IP do cliente no X-Forwarded-For):
#   1 = o Nginx do docker-compose
#   0 = acesso direto, sem proxy (ex.: npm run start:dev sem o Vite)
#   Em deploy (ex.: Render), conte os proxies da plataforma. Se o valor for MENOR
#   que o real, todos dividem o mesmo limite; se for MAIOR, o cliente consegue
#   forjar o IP e escapar do limite.
TRUST_PROXY_HOPS=1
# Janela de contagem, em segundos, e máximo de requisições por IP nessa janela:
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOOKUP=10
RATE_LIMIT_CANCEL=10
RATE_LIMIT_CREATE=100
